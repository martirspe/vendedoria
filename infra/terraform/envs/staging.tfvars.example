# Copy to envs/staging.tfvars (git-ignored). Staging sends from a subdomain so its SES identity does not
# collide with prod in the same account and region; account-level settings stay with prod.
environment        = "staging"
aws_region         = "us-east-1"
cloudflare_zone_id = "CLOUDFLARE_ZONE_ID"

media_domain = "media-staging.example.pe"

email_domain            = "staging.example.pe"
email_from              = "VendedorIA Staging <pedidos@staging.example.pe>"
manage_dmarc            = false
manage_account_settings = false
alerts_email            = "alertas@example.pe"
