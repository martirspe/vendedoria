# nginx interno del stack (127.0.0.1:${WEB_PORT}). HTTPS lo termina el nginx del servidor.
# Plantilla: la imagen oficial sustituye ${CONSOLE_HOST} y ${STORE_BASE_DOMAIN} al arrancar.

limit_req_zone $binary_remote_addr zone=api_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api_general:10m rate=300r/m;
limit_req_zone $binary_remote_addr zone=api_webhook:10m rate=120r/m;
limit_req_zone $binary_remote_addr zone=store_pages:10m rate=600r/m;

# Conserva el esquema original (https) enviado por el nginx del servidor.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# IP real del cliente: el único salto previo es el nginx del servidor o la red Docker.
set_real_ip_from 127.0.0.1;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Real-IP;

# Docker embedded DNS: re-resuelve tras recrear contenedores (evita 502 por IP vieja).
resolver 127.0.0.11 valid=10s ipv6=off;

server_tokens off;
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

# Consola de vendedores y API.
server {
    listen 80 default_server;
    server_name ${CONSOLE_HOST};

    client_max_body_size 10m;

    include /etc/nginx/snippets/security-headers.conf;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location /api/v1/webhooks/ {
        limit_req zone=api_webhook burst=40 nodelay;
        set $api_upstream api:3000;
        proxy_pass http://$api_upstream;
        include /etc/nginx/snippets/proxy-params.conf;
    }

    location /api/v1/auth/ {
        limit_req zone=api_auth burst=5 nodelay;
        set $api_upstream api:3000;
        proxy_pass http://$api_upstream;
        include /etc/nginx/snippets/proxy-params.conf;
    }

    location /api/ {
        limit_req zone=api_general burst=100 nodelay;
        set $api_upstream api:3000;
        proxy_pass http://$api_upstream;
        include /etc/nginx/snippets/proxy-params.conf;
    }

    # The marketing site lives on the bare domain.
    location = / {
        return 302 https://${STORE_BASE_DOMAIN}/;
    }

    location / {
        set $web_upstream web:4000;
        proxy_pass http://$web_upstream;
        include /etc/nginx/snippets/proxy-params.conf;
    }
}

# Web comercial en el dominio raíz (${STORE_BASE_DOMAIN}): mismas páginas prerenderizadas de la
# consola; entrar, crear cuenta y la consola viven solo en ${CONSOLE_HOST} (sesión en un único origen).
server {
    listen 80;
    server_name ${STORE_BASE_DOMAIN};

    client_max_body_size 1m;

    include /etc/nginx/snippets/security-headers.conf;

    location ~ ^/(app|auth)(/|$) {
        return 301 https://${CONSOLE_HOST}$request_uri;
    }

    location /api/ {
        return 404;
    }

    location / {
        limit_req zone=store_pages burst=120 nodelay;
        set $web_upstream web:4000;
        proxy_pass http://$web_upstream;
        include /etc/nginx/snippets/proxy-params.conf;
    }
}

# Tiendas públicas: {slug}.${STORE_BASE_DOMAIN}. El servidor de la tienda envía sus propias cabeceras de seguridad.
server {
    listen 80;
    server_name *.${STORE_BASE_DOMAIN};

    client_max_body_size 1m;

    location / {
        limit_req zone=store_pages burst=120 nodelay;
        set $store_upstream store:4300;
        proxy_pass http://$store_upstream;
        include /etc/nginx/snippets/proxy-params.conf;
    }
}
