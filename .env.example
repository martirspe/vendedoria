# Application
PORT=3000
CORS_ORIGIN=http://localhost:4200

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendedoria?schema=public

# Auth (generate long random secrets for local/prod; never commit real values)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-32+
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-32+
JWT_REFRESH_EXPIRES_DAYS=30

# Payments: each tenant connects its own Mercado Pago account from the console.
# Encrypts their credentials (openssl rand -hex 32). Without an account, development uses a simulator.
PAYMENT_CREDENTIALS_KEY=replace-with-64-hex-chars
# Plan payments (flow A) go to VendedorIA's own Mercado Pago account, paid inside the console
# (Card Payment Brick and Yape). Set all three from the same account and environment; webhook
# event: Order. Without them, development simulates plan payments and production disables paid plans.
# PLATFORM_MERCADOPAGO_ACCESS_TOKEN=
# PLATFORM_MERCADOPAGO_PUBLIC_KEY=
# PLATFORM_MERCADOPAGO_WEBHOOK_SECRET=
# Order confirmation emails: preview (recorded, not sent) or live (sent through EMAIL_PROVIDER)
EMAIL_MODE=preview
# ses (default, needs AWS_REGION or SES_REGION) or resend (needs RESEND_API_KEY)
# EMAIL_PROVIDER=ses
# EMAIL_FROM=VendedorIA <pedidos@example.pe>
# SES_REGION=us-east-1
# SES_CONFIGURATION_SET=vendedoria-transactional
# RESEND_API_KEY=

# Cloudflare Turnstile on login, sign-up and store checkout (set both or neither).
# Cloudflare test keys (always pass, any host) to try the widget locally; never in production.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Meta channels
META_VERIFY_TOKEN=replace-with-meta-verify-token
# Required in production; without it, development accepts unsigned webhooks.
# META_APP_SECRET=
# Instagram API with Instagram Login app secret; falls back to META_APP_SECRET.
# INSTAGRAM_APP_SECRET=
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Own store domains (Cloudflare for SaaS custom hostnames). Without them, local
# development activates domains directly and production hides the option.
# CLOUDFLARE_SAAS_ZONE_ID=
# CLOUDFLARE_SAAS_API_TOKEN=
# CUSTOM_DOMAIN_CNAME_TARGET=tiendas-cname.example.pe

# Web store: public URL of each tenant store ({slug} = tenant slug)
# Production example: https://{slug}.tiendas.example.pe
STOREFRONT_URL_TEMPLATE=http://{slug}.localhost:4300

# AI (optional — deterministic fallback if missing)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Store editor ambiance images (same key)
# OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Product photos uploaded from the console: local (UPLOADS_DIR, relative to apps/api) or s3
MEDIA_STORAGE=local
UPLOADS_DIR=uploads
# MEDIA_S3_BUCKET=vendedoria-media-dev
# MEDIA_CDN_URL=https://d111111abcdef8.cloudfront.net

# AWS (S3 media and SES email). Credentials use the AWS default chain: an instance role
# or a least-privilege IAM user's keys. Never use root account keys.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
