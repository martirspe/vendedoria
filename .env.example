# Application
PORT=3000
CORS_ORIGIN=http://localhost:4200

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendedoria?schema=public

# Auth (generate long random secrets for local/prod; never commit real values)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-32+
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-32+
JWT_REFRESH_EXPIRES_DAYS=30

# Payments — Flow B commerce checkout (optional; mock provider if empty)
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=

# Meta channels
META_VERIFY_TOKEN=replace-with-meta-verify-token
# META_APP_SECRET=
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# AI (optional — deterministic fallback if missing)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Storage (later)
# AWS_S3_BUCKET=
# AWS_REGION=
