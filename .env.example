# Application
PORT=3000
CORS_ORIGIN=http://localhost:4200

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendedoria?schema=public

# Auth (generate long random secrets for local/prod; never commit real values)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-32+
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-32+
JWT_REFRESH_EXPIRES_DAYS=30

# Payments: each tenant connects its own Mercado Pago account from the console.
# Encrypts their credentials (openssl rand -hex 32). Without an account, development uses a simulator.
PAYMENT_CREDENTIALS_KEY=replace-with-64-hex-chars
# Order confirmation emails: preview (recorded, not sent) or live (Resend)
EMAIL_MODE=preview
# RESEND_API_KEY=
# EMAIL_FROM=VendedorIA <pedidos@example.pe>

# Meta channels
META_VERIFY_TOKEN=replace-with-meta-verify-token
# META_APP_SECRET=
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Web store: public URL of each tenant store ({slug} = tenant slug)
# Production example: https://{slug}.tiendas.example.pe
STOREFRONT_URL_TEMPLATE=http://{slug}.localhost:4300

# AI (optional — deterministic fallback if missing)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Product photos uploaded from the console (relative to apps/api)
UPLOADS_DIR=uploads

# Storage (later)
# AWS_S3_BUCKET=
# AWS_REGION=
# CLOUDFRONT_URL=
