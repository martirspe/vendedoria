// VendedorIA — multi-tenant domain foundation
// Code and schema identifiers in English (Project Constitution)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum MembershipRole {
  OWNER
  ADMIN
  AGENT
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
}

enum ChannelConnectionMode {
  COEXISTENCE
  NEW_WABA_NUMBER
}

enum ChannelHealthStatus {
  CONNECTED
  DEGRADED
  DISCONNECTED
  PENDING
}

enum ConversationStatus {
  OPEN
  PAUSED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageAuthorType {
  BUYER
  SALES_AGENT
  HUMAN_OPERATOR
  SYSTEM
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  FULFILLING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentFlow {
  BILLING_SUBSCRIPTION
  COMMERCE_CHECKOUT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum KnowledgeReviewStatus {
  DRAFT
  APPROVED
}

enum KnowledgeSource {
  MANUAL
  PASTE_IMPORT
}

enum StorefrontStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum OrderChannel {
  WEB
  WHATSAPP
  INSTAGRAM
  MANUAL
}

enum CouponKind {
  PERCENT
  FIXED
  FREE_SHIPPING
  BUY_X_GET_Y
}

enum CouponScope {
  ALL
  CATEGORY
  BRAND
  PRODUCTS
}

enum CouponRedemptionStatus {
  HELD
  CONFIRMED
  RELEASED
}

enum JourneyStage {
  DISCOVER
  RECOMMEND
  CLOSE
  SUPPORT
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  fullName      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  refreshTokens RefreshToken[]
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  country   String   @default("PE")
  currency  String   @default("PEN")
  planTier  PlanTier @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  salesAgents        SalesAgent[]
  channels           Channel[]
  products           Product[]
  conversations      Conversation[]
  orders             Order[]
  payments           Payment[]
  playgroundSessions PlaygroundSession[]
  knowledgeFaqs      KnowledgeFaq[]
  journeyTemplates   JourneyTemplate[]
  storefront         Storefront?
  paymentAccounts    MerchantPaymentAccount[]
  coupons            Coupon[]
}

/// Buyer payments of a tenant go to the tenant's own Mercado Pago account.
/// Secrets are AES-256-GCM encrypted with PAYMENT_CREDENTIALS_KEY and never leave the API.
model MerchantPaymentAccount {
  id               String    @id @default(cuid())
  tenantId         String
  provider         String    @default("mercadopago")
  accessTokenEnc   String
  webhookSecretEnc String?
  publicKey        String
  liveMode         Boolean   @default(false)
  externalUserId   String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
}

model Coupon {
  id               String      @id @default(cuid())
  tenantId         String
  code             String
  label            String
  note             String?
  kind             CouponKind
  /// Percent (1-90), fixed amount in cents, or benefit percent of free units for BUY_X_GET_Y.
  value            Int
  maxDiscountCents Int?
  buyQuantity      Int?
  getQuantity      Int?
  maxApplications  Int?
  minSubtotalCents Int         @default(0)
  minItems         Int         @default(0)
  scope            CouponScope @default(ALL)
  /// Categories, brands or product handles depending on `scope`.
  targets          String[]    @default([])
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  firstOrderOnly   Boolean     @default(false)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]

  @@unique([tenantId, code])
}

/// Usage is derived from HELD + CONFIRMED rows, never from a mutable counter.
model CouponRedemption {
  id            String                 @id @default(cuid())
  couponId      String
  orderId       String                 @unique
  /// sha256 of the normalized buyer email.
  customerKey   String
  discountCents Int
  status        CouponRedemptionStatus @default(HELD)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, status])
  @@index([couponId, customerKey])
}

/// Public web store of a tenant, served at `{tenant.slug}.<platform domain>`.
model Storefront {
  id             String           @id @default(cuid())
  tenantId       String           @unique
  status         StorefrontStatus @default(DRAFT)
  displayName    String
  tagline        String?
  logoUrl        String?
  heroImageUrl   String?
  brandColor     String           @default("#0b0d12")
  accentColor    String           @default("#5b8cff")
  whatsappPhone  String?
  contactEmail   String?
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Legal identity (Peru): required to publish.
  legalName         String?
  ruc               String?
  legalAddress      String?
  complaintsBookUrl String?
  dataBankCode      String?
  /// Voluntary exchange window in days (0 = only the legal warranty).
  exchangeDays      Int     @default(0)

  // Shipping. Amounts in cents; null rate = zone not served.
  deliveryEnabled       Boolean @default(true)
  shippingLimaCents     Int?
  shippingProvinceCents Int?
  freeShippingFromCents Int?
  deliveryDaysLima      String?
  deliveryDaysProvince  String?
  pickupEnabled         Boolean @default(false)
  pickupAddress         String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole @default(OWNER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SalesAgent {
  id                     String   @id @default(cuid())
  tenantId               String
  name                   String
  companyName            String?
  companyDescription     String?
  audienceDescription    String?
  rulesText              String?
  communicationStyle     String?
  salesStyle             String?
  responseLength         String   @default("balanced")
  useEmojis              Boolean  @default(true)
  emojiPalette           String?
  wordsToAvoid           String?
  initialMessage         String?
  purchaseConfirmMessage String?
  handoffMessage         String?
  pauseOnHandoff         Boolean  @default(true)
  neverOfferDiscount     Boolean  @default(true)
  neverInventShipping    Boolean  @default(true)
  catalogOnlyFacts       Boolean  @default(true)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model KnowledgeFaq {
  id           String                @id @default(cuid())
  tenantId     String
  question     String
  answer       String
  tags         String[]              @default([])
  source       KnowledgeSource       @default(MANUAL)
  reviewStatus KnowledgeReviewStatus @default(APPROVED)
  isPublished  Boolean               @default(true)
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isPublished, reviewStatus])
}

model JourneyTemplate {
  id         String       @id @default(cuid())
  tenantId   String
  title      String
  stage      JourneyStage @default(DISCOVER)
  scriptText String
  isActive   Boolean      @default(true)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
}

model Channel {
  id             String                 @id @default(cuid())
  tenantId       String
  type           ChannelType
  connectionMode ChannelConnectionMode?
  healthStatus   ChannelHealthStatus    @default(PENDING)
  externalId     String?
  displayName    String?
  metadata       Json?
  lastActiveAt   DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, type, externalId])
  @@index([tenantId, type])
  @@index([externalId])
}

model Product {
  id                  String   @id @default(cuid())
  tenantId            String
  handle              String
  name                String
  descriptionShort    String?
  descriptionFull     String?
  categories          String[] @default([])
  basePriceCents      Int
  currency            String   @default("PEN")
  isAvailable         Boolean  @default(true)
  stockUnlimited      Boolean  @default(true)
  stockQty            Int?
  isPublishedOnStore  Boolean  @default(false)
  compareAtPriceCents Int?
  brand               String?
  sortOrder           Int      @default(0)
  seoTitle            String?
  seoDescription      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants   ProductVariant[]
  media      ProductMedia[]
  orderItems OrderItem[]

  @@unique([tenantId, handle])
  @@index([tenantId])
  @@index([tenantId, isPublishedOnStore])
}

model ProductVariant {
  id           String  @id @default(cuid())
  productId    String
  sku          String?
  option1Name  String?
  option1Value String?
  option2Name  String?
  option2Value String?
  option3Name  String?
  option3Value String?
  priceCents   Int
  isAvailable  Boolean @default(true)
  stockQty     Int?
  imageUrl     String?

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  url       String
  kind      String   @default("image")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Conversation {
  id               String             @id @default(cuid())
  tenantId         String
  channelId        String
  externalThreadId String?
  contactName      String?
  contactPhone     String?
  status           ConversationStatus @default(OPEN)
  agentEnabled     Boolean            @default(true)
  markedAsSale     Boolean            @default(false)
  markedUnattended Boolean            @default(false)
  lastInboundAt    DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel  Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messages Message[]
  orders   Order[]

  @@unique([channelId, externalThreadId])
  @@index([tenantId, status])
  @@index([tenantId, markedUnattended])
  @@index([channelId])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  direction      MessageDirection
  authorType     MessageAuthorType
  body           String
  externalId     String?
  metadata       Json?
  createdAt      DateTime          @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Isolated agent test thread — never appears in production inbox/metrics.
model PlaygroundSession {
  id        String   @id @default(cuid())
  tenantId  String
  title     String   @default("Prueba del vendedor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages PlaygroundMessage[]

  @@index([tenantId, updatedAt])
}

model PlaygroundMessage {
  id         String            @id @default(cuid())
  sessionId  String
  direction  MessageDirection
  authorType MessageAuthorType
  body       String
  /// Tool traces for operator trust (why the agent replied).
  toolTraces Json?
  createdAt  DateTime          @default(now())

  session PlaygroundSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Order {
  id             String       @id @default(cuid())
  tenantId       String
  conversationId String?
  status         OrderStatus  @default(DRAFT)
  channel        OrderChannel @default(MANUAL)
  /// Short human reference (e.g. "W7K2QD") shared with the buyer and over WhatsApp.
  code           String?
  currency       String       @default("PEN")
  subtotalCents  Int          @default(0)
  discountCents  Int          @default(0)
  shippingCents  Int          @default(0)
  totalCents     Int          @default(0)
  couponCode     String?
  customerName     String?
  customerPhone    String?
  customerEmail    String?
  customerDocument String?
  /// { mode, zone, address, district, reference, label, freeReason }
  delivery       Json?
  /// Idempotency of the web checkout.
  checkoutKey    String?      @unique
  requestHash    String?
  /// Grants anonymous access to the order page; never logged.
  publicToken    String?      @unique
  /// none | held | sold | released
  stockState     String       @default("none")
  expiresAt      DateTime?
  /// processing | review | pending | failed (web payment attempt state)
  paymentState   String?
  paymentKey     String?      @unique
  paymentHash    String?
  paymentMethod  String?
  paymentDetail  String?
  cancelReason   String?
  /// pending | preview | sent | failed
  emailStatus    String       @default("pending")
  emailClaimedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     Payment[]
  redemption   CouponRedemption?
  events       PaymentEvent[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, channel])
  @@index([stockState, expiresAt])
}

model PaymentEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  detail    String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// Deduplicates provider notifications (same id + request id).
model WebhookEvent {
  key         String   @id
  tenantId    String?
  providerId  String
  createdAt   DateTime @default(now())
  processedAt DateTime @default(now())
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String?
  variantId  String?
  title      String
  /// Snapshot for receipts after the product changes.
  handle     String?
  quantity   Int     @default(1)
  unitCents  Int
  totalCents Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Payment {
  id             String        @id @default(cuid())
  tenantId       String
  orderId        String?
  flow           PaymentFlow
  provider       String        @default("mercadopago")
  status         PaymentStatus @default(PENDING)
  amountCents    Int
  currency       String        @default("PEN")
  externalId     String?
  idempotencyKey String        @unique
  checkoutUrl    String?
  rawPayload     Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, flow, status])
}

/// Per-minute request counters for anonymous endpoints. `key` is an HMAC of IP, bucket and
/// window, so raw IPs are never stored. Rows are swept after they expire.
model RateLimitHit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
