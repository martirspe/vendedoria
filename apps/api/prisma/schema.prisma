// VendedorIA — multi-tenant domain foundation
// Code and schema identifiers in English (Project Constitution)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Plans in ascending order: Inicia, Crece, Escala, Lidera, A medida.
enum PlanTier {
  START
  GROW
  SCALE
  LEAD
  /// Custom plan quoted and granted by the team.
  ENTERPRISE
}

enum MembershipRole {
  OWNER
  ADMIN
  AGENT
}

/// VendedorIA staff role, unrelated to any tenant membership. Granted only through the create-admin CLI.
enum PlatformRole {
  SUPERADMIN
  ADMIN
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  TIKTOK_LIVE
}

enum ChannelConnectionMode {
  COEXISTENCE
  NEW_WABA_NUMBER
}

enum ChannelHealthStatus {
  CONNECTED
  DEGRADED
  DISCONNECTED
  PENDING
}

enum ConversationStatus {
  OPEN
  PAUSED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageAuthorType {
  BUYER
  SALES_AGENT
  HUMAN_OPERATOR
  SYSTEM
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  FULFILLING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentFlow {
  BILLING_SUBSCRIPTION
  COMMERCE_CHECKOUT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum KnowledgeReviewStatus {
  DRAFT
  APPROVED
}

enum KnowledgeSource {
  MANUAL
  PASTE_IMPORT
}

enum StorefrontStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

/// BUSINESS = has RUC (company or individual with business); INDIVIDUAL = sells without RUC, identified by DNI.
enum SellerType {
  BUSINESS
  INDIVIDUAL
}

enum ProductKind {
  PRODUCT
  SERVICE
  DIGITAL
}

enum OrderChannel {
  WEB
  WHATSAPP
  INSTAGRAM
  MANUAL
  TIKTOK_LIVE
}

enum CouponKind {
  PERCENT
  FIXED
  FREE_SHIPPING
  BUY_X_GET_Y
}

enum CouponMethod {
  CODE
  AUTOMATIC
}

enum CouponScope {
  ALL
  CATEGORY
  BRAND
  LINE
  PRODUCTS
}

enum CouponRedemptionStatus {
  HELD
  CONFIRMED
  RELEASED
}

enum JourneyStage {
  DISCOVER
  RECOMMEND
  CLOSE
  SUPPORT
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  fullName      String?
  /// Null for business users. Checked against the database on every platform request.
  platformRole  PlatformRole?
  /// Version of the platform terms (`LEGAL_TERMS_VERSION`) the user accepted, and when.
  termsVersion    String?
  termsAcceptedAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  refreshTokens RefreshToken[]
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  country   String   @default("PE")
  currency  String   @default("PEN")
  /// New businesses start a 14-day trial of Crece.
  planTier  PlanTier @default(GROW)
  /// Trial period: Crece with the reduced trial limits until planExpiresAt. Cleared by the first paid plan.
  planTrial Boolean  @default(true)
  /// End of the trial or paid period; after it the plan is expired. Null: no expiry (granted by the team).
  planExpiresAt DateTime? @default(dbgenerated("(now() + '14 days'::interval)"))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  salesAgents        SalesAgent[]
  channels           Channel[]
  products           Product[]
  conversations      Conversation[]
  orders             Order[]
  payments           Payment[]
  playgroundSessions PlaygroundSession[]
  knowledgeFaqs      KnowledgeFaq[]
  journeyTemplates   JourneyTemplate[]
  storefront         Storefront?
  paymentAccounts    MerchantPaymentAccount[]
  coupons            Coupon[]
  slugRedirects      StoreSlugRedirect[]
  chatPacks          ChatPack[]
  aiUsage            AiUsageMonth[]
  integrations       TenantIntegration[]
  memberInvites      MemberInvite[]
  storeVersions      StorefrontVersion[]
  conversionSettings ConversionSettings?
  recoveryCarts      RecoveryCart[]
  recoveryDeliveries RecoveryDelivery[]
  storeBehavior     StoreBehaviorEvent[]
  liveIntegration   LiveIntegration?
  liveCampaigns     LiveCampaign[]
  liveSessions      LiveSession[]
  liveReservations  LiveReservation[]
  liveEvents        LiveEvent[]
  customerMemories  SalesCustomerMemory[]
  salesTurns        SalesEngineTurn[]
  salesSearchJobs   SalesSearchJob[]
}

model ConversionSettings {
  tenantId String @id
  recoveryEnabled Boolean @default(false)
  emailEnabled Boolean @default(true)
  whatsappEnabled Boolean @default(false)
  whatsappTemplate String?
  whatsappLanguage String @default("es_PE")
  delaysMinutes Int[] @default([15, 120, 1440])
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Contact data is retained only until expiry; links contain no buyer data.
model RecoveryCart {
  id String @id @default(cuid())
  tenantId String
  sessionHash String
  items Json
  email String?
  phone String?
  emailConsentAt DateTime?
  whatsappConsentAt DateTime?
  consentVersion String
  revision Int @default(1)
  lastActivityAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  orderId String?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries RecoveryDelivery[]
  @@unique([tenantId, sessionHash])
  @@index([tenantId, expiresAt])
  @@index([expiresAt])
}

/// Durable outbox. SENDING after a crash becomes UNCERTAIN, never blindly resent.
model RecoveryDelivery {
  id String @id @default(cuid())
  tenantId String
  cartId String
  revision Int
  step Int
  channel String
  status String @default("PENDING")
  dueAt DateTime
  claimedAt DateTime?
  attempts Int @default(0)
  sentAt DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart RecoveryCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  @@unique([cartId, revision, step, channel])
  @@index([tenantId, status, dueAt])
  @@index([status, dueAt])
}

/// No email/phone/IP. Anonymous behavior is recorded only after explicit consent.
model StoreBehaviorEvent {
  id String @id @default(cuid())
  tenantId String
  sessionHash String
  handle String
  kind String
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, sessionHash, createdAt])
  @@index([createdAt])
}

/// Extra new chats bought on top of the plan for one calendar month (flow A).
model ChatPack {
  id          String   @id @default(cuid())
  tenantId    String
  paymentId   String   @unique
  chats       Int
  /// First day (00:00 UTC) of the calendar month the chats count toward.
  periodStart DateTime
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, periodStart])
}

/// AI use per calendar month; each feature has its own cap in the plan.
model AiUsageMonth {
  tenantId     String
  periodStart  DateTime
  /// Sales agent replies written with OpenAI.
  replies      Int      @default(0)
  /// Texts and sections written by the store editor assistant.
  editorTexts  Int      @default(0)
  /// Images generated by the store editor assistant.
  editorImages Int      @default(0)
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, periodStart])
}

/// Optional features the business turns on from Integraciones (custom_domain, instagram, tracking, team).
model TenantIntegration {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

/// Invitation link to join a business team. Only the sha256 of the token is stored.
model MemberInvite {
  id         String         @id @default(cuid())
  tenantId   String
  email      String
  role       MembershipRole @default(AGENT)
  tokenHash  String         @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, acceptedAt])
}

/// Former store subdomains of a tenant: the store server redirects them to the current slug,
/// and no other tenant can claim them.
model StoreSlugRedirect {
  slug      String   @id
  tenantId  String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// Buyer payments of a tenant go to the tenant's own Mercado Pago account.
/// Secrets are AES-256-GCM encrypted with PAYMENT_CREDENTIALS_KEY and never leave the API.
model MerchantPaymentAccount {
  id               String    @id @default(cuid())
  tenantId         String
  provider         String    @default("mercadopago")
  accessTokenEnc   String
  webhookSecretEnc String?
  publicKey        String
  liveMode         Boolean   @default(false)
  externalUserId   String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
}

model Coupon {
  id               String      @id @default(cuid())
  tenantId         String
  code             String
  method           CouponMethod @default(CODE)
  label            String
  note             String?
  kind             CouponKind
  /// Percent (1-90), fixed amount in cents, or benefit percent of free units for BUY_X_GET_Y.
  value            Int
  maxDiscountCents Int?
  buyQuantity      Int?
  getQuantity      Int?
  maxApplications  Int?
  minSubtotalCents Int         @default(0)
  minItems         Int         @default(0)
  scope            CouponScope @default(ALL)
  /// Categories, brands, lines or product handles depending on `scope`.
  targets          String[]    @default([])
  /// False excludes products sold as sets (with components) from the discount.
  applyToSets      Boolean     @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  firstOrderOnly   Boolean     @default(false)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]

  @@unique([tenantId, code])
}

/// Usage is derived from HELD + CONFIRMED rows, never from a mutable counter.
model CouponRedemption {
  id            String                 @id @default(cuid())
  couponId      String
  orderId       String                 @unique
  /// sha256 of the normalized buyer email.
  customerKey   String
  discountCents Int
  status        CouponRedemptionStatus @default(HELD)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, status])
  @@index([couponId, customerKey])
}

/// Public web store of a tenant, served at `{tenant.slug}.<platform domain>`.
model Storefront {
  id             String           @id @default(cuid())
  tenantId       String           @unique
  status         StorefrontStatus @default(DRAFT)
  displayName    String
  tagline        String?
  logoUrl        String?
  heroImageUrl   String?
  brandColor     String           @default("#0b0d12")
  accentColor    String           @default("#5b8cff")
  whatsappPhone  String?
  contactEmail   String?
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Legal identity (Peru): required to publish.
  sellerType        SellerType @default(BUSINESS)
  legalName         String?
  ruc               String?
  /// Full address. Public for BUSINESS; for INDIVIDUAL it is a private notification address.
  legalAddress      String?
  /// INDIVIDUAL only, never public.
  dni               String?
  /// INDIVIDUAL only: "district, province" shown in the store instead of the address.
  legalDistrict     String?
  complaintsBookUrl String?
  dataBankCode      String?
  /// Voluntary exchange window in days (0 = only the legal warranty).
  exchangeDays      Int     @default(0)

  // Shipping. Amounts in cents; home delivery is priced by ubigeo (courier rates by distance).
  deliveryEnabled       Boolean @default(true)
  freeShippingFromCents Int?
  pickupEnabled         Boolean @default(false)
  pickupAddress         String?
  /// Courier rates by distance from this INEI district.
  shippingOriginUbigeo  String?
  /// { olva?: number[5], shalom?: number[5] } in cents per distance tier.
  carrierRates          Json?

  /// Business type; it decides which templates the merchant can choose.
  industry     String @default("general")
  /// Stable theme catalog slug. Existing stores remain pinned to their original release.
  template     String @default("classic")
  themeVersion String @default("1.0.0")
  /// Pending theme selection/update; published atomically with templateDraft.
  themeDraftTemplate String?
  themeDraftVersion String?
  /// Legacy flat template texts, copied into `templateContent` by migration 0004; no longer read.
  templateCopy    Json?
  /// Published template content (StoreTemplateContent); null uses the template defaults.
  templateContent Json?
  /// Unpublished edits from the visual editor; only preview links render it. Null = no pending changes.
  templateDraft   Json?
  /// The draft is published automatically at this time; cleared when it is published or discarded.
  templatePublishAt DateTime?

  /// Own domain of the store (e.g. www.mitienda.pe), lowercase, unique across tenants.
  customDomain           String?   @unique
  /// pending | active | failed
  customDomainStatus     String?
  /// Cloudflare for SaaS custom hostname id.
  customDomainProviderId String?
  customDomainCheckedAt  DateTime?
  /// Store analytics, loaded only after the buyer accepts cookies.
  metaPixelId            String?
  ga4MeasurementId       String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([templatePublishAt])
}

/// Template content that was published until `replacedAt`; the editor restores one into the draft.
model StorefrontVersion {
  id         String   @id @default(cuid())
  tenantId   String
  /// StoreTemplateContent
  content    Json
  /// Null only for historical content snapshots created before theme identity was tracked.
  template String?
  themeVersion String?
  replacedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, replacedAt])
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole @default(OWNER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  /// Platform sessions are refreshed only by /platform/auth/refresh, business sessions only by /auth/refresh.
  platform  Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Who did what on the platform. actorUserId is null for the create-admin CLI. metadata never holds PII.
model PlatformAuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?
  action         String
  targetUserId   String?
  targetTenantId String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
}

model SalesAgent {
  id                     String   @id @default(cuid())
  tenantId               String
  name                   String
  companyName            String?
  companyDescription     String?
  audienceDescription    String?
  rulesText              String?
  communicationStyle     String?
  personalityPreset      String?
  salesStyle             String?
  responseLength         String   @default("balanced")
  useEmojis              Boolean  @default(true)
  emojiPalette           String?
  wordsToAvoid           String?
  initialMessage         String?
  purchaseConfirmMessage String?
  handoffMessage         String?
  pauseOnHandoff         Boolean  @default(true)
  neverOfferDiscount     Boolean  @default(true)
  neverInventShipping    Boolean  @default(true)
  catalogOnlyFacts       Boolean  @default(true)
  /// Sales technique ids from agent-runtime/sales-playbook.ts the agent emphasizes.
  salesTechniques        String[] @default(["discovery", "benefits", "objections", "alternative_close", "cross_sell"])
  /// Merchant answers to frequent buyer objections (price, trust, timing...).
  objectionHandling      String?
  /// `guided`: prompt compiled from the form; `custom`: customPrompt replaces the persona section.
  promptMode             String   @default("guided")
  customPrompt           String?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channels Channel[]
  liveCampaigns LiveCampaign[]

  @@index([tenantId])
}

model KnowledgeFaq {
  id           String                @id @default(cuid())
  tenantId     String
  question     String
  answer       String
  tags         String[]              @default([])
  source       KnowledgeSource       @default(MANUAL)
  reviewStatus KnowledgeReviewStatus @default(APPROVED)
  isPublished  Boolean               @default(true)
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isPublished, reviewStatus])
}

model JourneyTemplate {
  id         String       @id @default(cuid())
  tenantId   String
  title      String
  stage      JourneyStage @default(DISCOVER)
  scriptText String
  isActive   Boolean      @default(true)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
}

model Channel {
  id             String                 @id @default(cuid())
  tenantId       String
  type           ChannelType
  connectionMode ChannelConnectionMode?
  healthStatus   ChannelHealthStatus    @default(PENDING)
  externalId     String?
  displayName    String?
  metadata       Json?
  lastActiveAt   DateTime?
  /// Sales agent that answers this channel; null falls back to the tenant's primary agent.
  salesAgentId   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesAgent    SalesAgent?    @relation(fields: [salesAgentId], references: [id], onDelete: SetNull)
  conversations Conversation[]

  @@unique([tenantId, type, externalId])
  @@index([tenantId, type])
  @@index([externalId])
  @@index([salesAgentId])
}

model Product {
  id                  String   @id @default(cuid())
  tenantId            String
  handle              String
  name                String
  descriptionShort    String?
  descriptionFull     String?
  categories          String[] @default([])
  categoryId          String?
  attributeValues     Json?
  basePriceCents      Int
  currency            String   @default("PEN")
  /// SERVICE and DIGITAL have no stock, are never shipped and cannot be a set or a set piece.
  kind                ProductKind @default(PRODUCT)
  /// Services only: approximate length shown to buyers.
  durationMinutes     Int?
  /// Services only: onsite | home | online
  serviceMode         String?
  /// Digital only: where the buyer gets the content. Revealed only on paid orders, never in public payloads.
  digitalAccessUrl    String?
  /// Digital only: how to use the access (passwords are not stored here).
  digitalInstructions String?
  isAvailable         Boolean  @default(true)
  stockUnlimited      Boolean  @default(true)
  stockQty            Int?
  isPublishedOnStore  Boolean  @default(false)
  compareAtPriceCents Int?
  brand               String?
  sku                 String?
  /// Product line inside the brand (coupons and related products).
  line                String?
  /// { size, benefits[], usage[], notes[], highlights[], family, intensity, scent[], montage }
  details             Json?
  sortOrder           Int      @default(0)
  seoTitle            String?
  seoDescription      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    CatalogCategory?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  media       ProductMedia[]
  orderItems  OrderItem[]
  /// Pieces of this product when it is sold as a set.
  components  ProductComponent[] @relation("SetComponents")
  /// Sets that include this product as a piece.
  componentOf ProductComponent[] @relation("ComponentOf")
  liveOffers LiveOffer[]

  @@unique([tenantId, handle])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, isPublishedOnStore])
  @@index([tenantId, isAvailable, sortOrder, updatedAt])
}

model ProductVariant {
  id           String  @id @default(cuid())
  productId    String
  sku          String?
  option1Name  String?
  option1Value String?
  option2Name  String?
  option2Value String?
  option3Name  String?
  option3Value String?
  priceCents   Int
  isAvailable  Boolean @default(true)
  stockQty     Int?
  imageUrl     String?
  /// Extensible option pairs; null reads the legacy three pairs.
  options      Json?
  combinationKey String?
  /// Effective price stays materialized for existing order/agent readers.
  priceInherited Boolean @default(false)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  liveOffers LiveOffer[]

  @@index([productId])
  @@unique([productId, combinationKey])
}

/// Shared classification managed as catalog data, separate from merchant collection labels.
model CatalogCategory {
  id         String @id
  name       String
  kind       ProductKind @default(PRODUCT)
  parentId   String?
  /// [{ key, name, group, required, variant, values?, maxLength? }], inherited from ancestors.
  attributes Json
  parent     CatalogCategory? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   CatalogCategory[] @relation("CategoryTree")
  products   Product[]

  @@index([parentId])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  url       String
  /// image | related (ambient photo shown in the product details)
  kind      String   @default("image")
  alt       String?
  caption   String?
  sortOrder Int      @default(0)
  /// SHA-256 of the original file when it came from a catalog import; re-imports reuse the URL.
  sourceHash String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sourceHash])
}

/// A set consumes the stock of its pieces; its own stock fields are ignored.
model ProductComponent {
  id          String @id @default(cuid())
  setId       String
  componentId String
  quantity    Int    @default(1)

  set       Product @relation("SetComponents", fields: [setId], references: [id], onDelete: Cascade)
  component Product @relation("ComponentOf", fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([setId, componentId])
  @@index([componentId])
}

model Conversation {
  id               String             @id @default(cuid())
  tenantId         String
  channelId        String
  externalThreadId String?
  contactName      String?
  contactPhone     String?
  status           ConversationStatus @default(OPEN)
  agentEnabled     Boolean            @default(true)
  markedAsSale     Boolean            @default(false)
  markedUnattended Boolean            @default(false)
  lastInboundAt    DateTime?
  salesState       Json               @default("{}")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel  Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messages Message[]
  orders   Order[]
  salesTurns SalesEngineTurn[]

  @@unique([channelId, externalThreadId])
  @@index([tenantId, status])
  @@index([tenantId, markedUnattended])
  @@index([channelId])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  direction      MessageDirection
  authorType     MessageAuthorType
  body           String
  externalId     String?
  inboundKey     String?           @unique
  enginePending  Boolean           @default(false)
  metadata       Json?
  createdAt      DateTime          @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([enginePending, createdAt])
}

/// Persisted before actions/send. Interrupted actions or uncertain sends require human review.
model SalesEngineTurn {
  id String @id @default(cuid())
  tenantId String
  conversationId String
  inboundIds String[]
  status String @default("STARTED")
  response Json?
  trace Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([tenantId, conversationId, createdAt])
  @@index([status, updatedAt])
}

/// Explicit preferences only; customerKey is a hash of the backend-resolved channel/thread.
model SalesCustomerMemory {
  tenantId String
  customerKey String
  facts Json
  expiresAt DateTime
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@id([tenantId, customerKey])
  @@index([tenantId, expiresAt])
}

/// Transactional index outbox populated by catalog/FAQ database triggers.
model SalesSearchJob {
  id String @id @default(cuid())
  tenantId String
  sourceId String
  documentType String
  revision Int @default(1)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, documentType, sourceId])
  @@index([availableAt])
}

/// Isolated agent test thread — never appears in production inbox/metrics.
model PlaygroundSession {
  id        String   @id @default(cuid())
  tenantId  String
  title     String   @default("Prueba del vendedor")
  salesState Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages PlaygroundMessage[]

  @@index([tenantId, updatedAt])
}

model PlaygroundMessage {
  id         String            @id @default(cuid())
  sessionId  String
  direction  MessageDirection
  authorType MessageAuthorType
  body       String
  /// Tool traces for operator trust (why the agent replied).
  toolTraces Json?
  createdAt  DateTime          @default(now())

  session PlaygroundSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Order {
  id             String       @id @default(cuid())
  tenantId       String
  conversationId String?
  status         OrderStatus  @default(DRAFT)
  channel        OrderChannel @default(MANUAL)
  /// Short human reference (e.g. "W7K2QD") shared with the buyer and over WhatsApp.
  code           String?
  currency       String       @default("PEN")
  subtotalCents  Int          @default(0)
  discountCents  Int          @default(0)
  shippingCents  Int          @default(0)
  totalCents     Int          @default(0)
  couponCode     String?
  customerName     String?
  customerPhone    String?
  customerEmail    String?
  customerDocument String?
  /// { mode, zone, address, district, reference, label, freeReason }; null when the order has only services.
  delivery       Json?
  /// Buyer's preferred date or notes for the services in the order; a wish, never a confirmed booking.
  serviceNote    String?
  /// Idempotency of the web checkout.
  checkoutKey    String?      @unique
  requestHash    String?
  /// Grants anonymous access to the order page; never logged.
  publicToken    String?      @unique
  /// none | held | sold | released
  stockState     String       @default("none")
  expiresAt      DateTime?
  /// processing | review | pending | failed (web payment attempt state)
  paymentState   String?
  paymentKey     String?      @unique
  paymentHash    String?
  paymentMethod  String?
  paymentDetail  String?
  cancelReason   String?
  /// Courier tracking code, required to mark a home delivery as shipped.
  trackingCode   String?
  /// pending | preview | sent | failed
  emailStatus    String       @default("pending")
  emailClaimedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     Payment[]
  redemption   CouponRedemption?
  events       PaymentEvent[]
  liveReservation LiveReservation?

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, channel])
  @@index([stockState, expiresAt])
}

model PaymentEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  detail    String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// Deduplicates provider notifications (same id + request id).
model WebhookEvent {
  key         String   @id
  tenantId    String?
  providerId  String
  createdAt   DateTime @default(now())
  processedAt DateTime @default(now())
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String?
  variantId  String?
  title      String
  /// Snapshot for receipts after the product changes.
  handle     String?
  quantity   Int     @default(1)
  unitCents  Int
  totalCents Int
  /// Set pieces taken at reservation: [{ productId, quantity }].
  allocations Json?
  /// Delivery promised at purchase; preserves digital access after catalog edits or deletion.
  fulfillment Json?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId, orderId])
}

model Payment {
  id             String        @id @default(cuid())
  tenantId       String
  orderId        String?
  flow           PaymentFlow
  provider       String        @default("mercadopago")
  status         PaymentStatus @default(PENDING)
  amountCents    Int
  currency       String        @default("PEN")
  externalId     String?
  idempotencyKey String        @unique
  checkoutUrl    String?
  rawPayload     Json?
  /// Plan bought by a BILLING_SUBSCRIPTION payment (flow A).
  planTier       PlanTier?
  /// Months paid in advance with planTier (1, 3, 6 or 12).
  planMonths     Int?
  /// Extra new chats bought by a BILLING_SUBSCRIPTION payment without planTier.
  chatPackSize   Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, flow, status])
}

/// Per-minute request counters for anonymous endpoints. `key` is an HMAC of IP, bucket and
/// window, so raw IPs are never stored. Rows are swept after they expire.
model RateLimitHit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

/// Login Kit identity is independent of permission to read or respond in a LIVE.
model LiveIntegration {
  tenantId String @id
  channelId String?
  healthStatus ChannelHealthStatus @default(PENDING)
  credentialsEncrypted String?
  accountId String?
  scopes String[] @default([])
  capabilities Json @default("{}")
  oauthStateHash String? @unique
  oauthExpiresAt DateTime?
  accessExpiresAt DateTime?
  refreshExpiresAt DateTime?
  responseMode String @default("HUMAN_APPROVAL")
  reservationSeconds Int @default(300)
  maxReservationsPerSession Int @default(500)
  lastCheckedAt DateTime?
  lastEventAt DateTime?
  errorCode String?
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model LiveCampaign {
  id String @id @default(cuid())
  tenantId String
  name String
  channel String @default("TIKTOK_LIVE")
  status String @default("DRAFT")
  mode String @default("LIVE_LIQUIDATION")
  startsAt DateTime?
  endsAt DateTime?
  salesAgentId String?
  reservationSeconds Int @default(300)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesAgent SalesAgent? @relation(fields: [salesAgentId], references: [id], onDelete: SetNull)
  offers LiveOffer[]
  sessions LiveSession[]
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
}

model LiveOffer {
  id String @id @default(cuid())
  tenantId String
  campaignId String
  productId String
  variantId String?
  livePriceCents Int
  allocatedStock Int
  /// Pending holds + checked-out holds + sold units; released holds decrement it.
  claimedQty Int @default(0)
  maxPerCustomer Int @default(2)
  durationSeconds Int @default(3600)
  sortOrder Int @default(0)
  enabled Boolean @default(true)
  campaign LiveCampaign @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  reservations LiveReservation[]
  @@unique([tenantId, id])
  @@index([tenantId, campaignId, sortOrder])
}

model LiveSession {
  id String @id @default(cuid())
  tenantId String
  campaignId String
  status String @default("ACTIVE")
  currentOfferId String?
  startedAt DateTime @default(now())
  endedAt DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign LiveCampaign @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  reservations LiveReservation[]
  events LiveEvent[]
  @@unique([tenantId, id])
  @@index([tenantId, status, startedAt])
}

model LiveReservation {
  id String @id @default(cuid())
  tenantId String
  sessionId String
  offerId String
  conversationId String
  customerKey String
  idempotencyKey String
  status String @default("PENDING")
  quantity Int
  unitCents Int
  /// The stock recipe and commercial snapshot actually reserved, independent of catalog edits.
  line Json
  expiresAt DateTime
  orderId String? @unique
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session LiveSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)
  offer LiveOffer @relation(fields: [tenantId, offerId], references: [tenantId, id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, sessionId, customerKey, offerId, status])
  @@index([tenantId, status, expiresAt])
  @@index([status, expiresAt])
}

/// Durable business events. External payloads and personal identifiers are not stored here.
model LiveEvent {
  id String @id @default(cuid())
  tenantId String
  sessionId String
  kind String
  externalEventId String
  conversationId String?
  intent String?
  reservationId String?
  suggestedReply String?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session LiveSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)
  @@unique([tenantId, externalEventId])
  @@index([tenantId, sessionId, createdAt])
}
