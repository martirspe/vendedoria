# VendedorIA — producción (copiar a .env en el servidor; nunca subir valores reales).
# Desplegar con: bash scripts/deploy.sh
# docker-compose.yml calcula DATABASE_URL, CORS_ORIGIN, PUBLIC_API_BASE_URL y
# STOREFRONT_URL_TEMPLATE a partir de estas variables.
# Vacíos = generados por el primer deploy: POSTGRES_PASSWORD, JWT_ACCESS_SECRET,
# JWT_REFRESH_SECRET y PAYMENT_CREDENTIALS_KEY.

# Dominios. DNS en Cloudflare (solo DNS, nube gris): A @ y A * → IP del VPS.
# Web comercial en https://STORE_BASE_DOMAIN (www redirige), tiendas en
# https://{slug}.STORE_BASE_DOMAIN y consola en CONSOLE_HOST.
STORE_BASE_DOMAIN=example.pe
CONSOLE_HOST=app.example.pe

# HTTPS automático (Let's Encrypt), como Reclamo Fácil. Token de Cloudflare obligatorio:
# Mi perfil → Tokens de API → Crear token → plantilla "Editar DNS de zona" → zona del dominio.
# Si CERTBOT_EMAIL queda vacío se usa el correo de EMAIL_FROM.
CERTBOT_EMAIL=
CLOUDFLARE_API_TOKEN=

# Puerto local del nginx interno, único por app en el VPS (gohabix 8080, Selecta 8081)
WEB_PORT=8082
# Nombre del vhost en /etc/nginx/sites-available
NGINX_SITE_NAME=vendedoria
TZ=America/Lima

# PostgreSQL (contraseña solo con letras, dígitos y . _ ~ -)
POSTGRES_USER=vendedoria
POSTGRES_PASSWORD=
POSTGRES_DB=vendedoria

# Auth (mínimo 32 caracteres)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_DAYS=30

# Meta channels. Sin META_APP_SECRET el webhook de WhatsApp rechaza todos los
# mensajes entrantes en producción (la firma es obligatoria).
META_VERIFY_TOKEN=
META_APP_SECRET=
# Instagram Direct (app de Instagram API con inicio de sesión de Instagram).
# Webhook: https://CONSOLE_HOST/api/v1/webhooks/meta/instagram (mismo META_VERIFY_TOKEN).
# Vacío = usa META_APP_SECRET para validar la firma.
INSTAGRAM_APP_SECRET=

# Dominio propio de las tiendas (Cloudflare for SaaS, ver docs/DEPLOY.md).
# Sin estas variables la integración «Dominio propio» no se ofrece en producción.
# Token con permiso "SSL and Certificates: Edit" sobre la zona SaaS.
CLOUDFLARE_SAAS_ZONE_ID=
CLOUDFLARE_SAAS_API_TOKEN=
# Host al que tus clientes apuntan su CNAME (fallback origin de Cloudflare for SaaS)
CUSTOM_DOMAIN_CNAME_TARGET=

# Cloudflare Turnstile en entrar, crear cuenta y checkout de las tiendas (las dos o ninguna).
# Widget en modo Managed con el hostname STORE_BASE_DOMAIN (cubre la consola y todas las tiendas).
# Sin ellas, esos formularios solo quedan protegidos por el límite de intentos por IP.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Pagos: cada negocio conecta su propia cuenta de Mercado Pago desde la consola.
# Esta clave cifra sus credenciales (openssl rand -hex 32). No la cambies después:
# las cuentas ya conectadas dejarían de poder descifrarse.
PAYMENT_CREDENTIALS_KEY=

# Cobro de planes a los negocios (cuenta de Mercado Pago de VendedorIA, distinta de
# las de cada negocio). Se paga dentro de la consola con tarjeta o Yape, sin salir a Mercado Pago.
# Las tres de la misma cuenta y ambiente. Webhook en Mercado Pago, evento Order:
# https://CONSOLE_HOST/api/v1/webhooks/billing/mercadopago
# Sin estas variables, comprar un plan pagado no está disponible.
PLATFORM_MERCADOPAGO_ACCESS_TOKEN=
PLATFORM_MERCADOPAGO_PUBLIC_KEY=
PLATFORM_MERCADOPAGO_WEBHOOK_SECRET=

# Credenciales de AWS para S3 y SES: usuario IAM con permisos mínimos creado por
# infra/terraform (`terraform output -raw server_env` da el resto de variables de AWS)
# o rol de instancia en EC2. Nunca claves de la cuenta raíz.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Correos de pedidos: preview (no envía) o live. Con live la API no arranca si falta
# EMAIL_FROM (identidad verificada en SES con DKIM) o la región.
EMAIL_MODE=preview
EMAIL_PROVIDER=ses
# EMAIL_FROM=VendedorIA <pedidos@example.pe>
# Solo si SES está en otra región que AWS_REGION
# SES_REGION=us-east-1
# Configuration set con eventos de rebote/queja y supresión
# SES_CONFIGURATION_SET=vendedoria-prod-transactional
# Alternativa: EMAIL_PROVIDER=resend con RESEND_API_KEY
# RESEND_API_KEY=

# Fotos de productos: local (volumen `uploads` en docker-compose.yml) o s3 (bucket privado
# servido por CloudFront con Origin Access Control). Las fotos subidas antes de cambiar a s3
# se siguen sirviendo desde el volumen, no lo borres.
MEDIA_STORAGE=local
UPLOADS_DIR=/app/apps/api/uploads
# MEDIA_S3_BUCKET=vendedoria-media-prod
# MEDIA_CDN_URL=https://media.example.pe

# IA (opcional)
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_IMAGE_MODEL=

# Límites de memoria
# API_MEMORY_LIMIT=512M
# WEB_MEMORY_LIMIT=384M
# STORE_MEMORY_LIMIT=512M
# POSTGRES_MEMORY_LIMIT=512M

# Conversion: Redis has no public port; Qdrant is optional (profile recommendations-vector).
REDIS_URL=redis://redis:6379/0
QDRANT_URL=
QDRANT_API_KEY=
# Verified marketing identity, separate from transactional EMAIL_FROM. Required for live email recovery.
RECOVERY_EMAIL_FROM=

# TikTok official Login Kit, optional. Register this exact HTTPS redirect in TikTok.
# Requires PAYMENT_CREDENTIALS_KEY and a single HTTPS CORS_ORIGIN.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://api.example.pe/api/v1/integrations/tiktok-live/oauth/callback
# AI Sales Engine: deploy the additive migration before enabling the v2 inbox.
SALES_ENGINE_MODE=sales-engine-v2
SALES_DEBOUNCE_MS=2000
SALES_RECENT_MESSAGES_LIMIT=20
SALES_SUMMARY_THRESHOLD=5
SALES_CONTEXT_TOKEN_BUDGET=16000
SALES_MEMORY_TTL_SECONDS=1800
SALES_CUSTOMER_MEMORY_TTL_DAYS=90
SALES_LOCK_TTL_MS=30000
SALES_TOOL_TIMEOUT_MS=10000
SALES_RETRIEVAL_TOP_K=12
SALES_SIMILARITY_THRESHOLD=0.3
SALES_EMBEDDING_MODEL=text-embedding-3-small
SALES_HANDOFF_FAILURE_THRESHOLD=3
SALES_GATEWAY_CONCURRENCY=1
