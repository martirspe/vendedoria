{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vendedoria.dev/schemas/theme-manifest-v1.json",
  "title": "VendedorIA theme manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "namespace", "slug", "displayName", "version", "author", "license", "description", "renderer", "contracts", "capabilities", "industries", "sections", "settings", "tokens", "assets", "presets", "migrations", "changelog"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}/[a-z][a-z0-9-]{1,39}$" },
    "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "maxLength": 32 },
    "author": { "type": "string", "minLength": 1, "maxLength": 120 },
    "license": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "renderer": { "type": "string", "pattern": "^(classic|selecta|stride)@[1-9][0-9]*$" },
    "contracts": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "editor", "storefront", "content"],
      "properties": {
        "engine": { "type": "integer", "minimum": 1 },
        "editor": { "type": "integer", "minimum": 1 },
        "storefront": { "type": "integer", "minimum": 1 },
        "content": { "type": "integer", "minimum": 1 }
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false, "required": ["requires", "supports", "optional"],
      "properties": {
        "requires": { "type": "array", "uniqueItems": true, "maxItems": 40, "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]{1,39}$" } },
        "supports": { "type": "array", "uniqueItems": true, "maxItems": 40, "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]{1,39}$" } },
        "optional": { "type": "array", "uniqueItems": true, "maxItems": 40, "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]{1,39}$" } }
      }
    },
    "industries": { "anyOf": [
      { "type": "string", "enum": ["all"] },
      { "type": "array", "minItems": 1, "maxItems": 9, "uniqueItems": true, "items": { "type": "string", "enum": ["general", "belleza", "moda", "hogar", "alimentos", "tecnologia", "salud", "mascotas", "otros"] } }
    ] },
    "sections": { "type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,39}$" } },
    "settings": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "enum": ["logo", "favicon", "primary", "accent", "font", "corners", "background", "surface", "text", "muted", "border", "container", "spacing", "typeScale"] } },
    "tokens": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "surface": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "text": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "muted": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "border": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "font": { "type": "string", "enum": ["modern", "editorial", "simple"] },
        "corners": { "type": "string", "enum": ["square", "soft", "round"] },
        "container": { "type": "string", "enum": ["compact", "standard", "wide"] },
        "spacing": { "type": "string", "enum": ["compact", "standard", "airy"] },
        "typeScale": { "type": "string", "enum": ["standard", "large"] }
      }
    },
    "assets": {
      "type": "object", "additionalProperties": false, "required": ["cover", "styles"],
      "properties": {
        "cover": { "type": "string", "pattern": "^/template-previews/[a-z][a-z0-9-]*\\.(webp|png|jpg)$", "maxLength": 160 },
        "styles": { "type": "array", "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^/[a-z][a-z0-9-]*\\.css$" } }
      }
    },
    "presets": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "label", "sections", "layout"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "sections": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 1200 } } },
          "layout": { "type": "array", "minItems": 1, "maxItems": 40, "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "type"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,39}$" },
              "type": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,39}$" },
              "hidden": { "type": "boolean" }
            }
          } }
        }
      }
    },
    "migrations": {
      "type": "array", "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["from", "to", "renameFields"],
        "properties": {
          "from": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
          "to": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
          "renameFields": { "type": "array", "maxItems": 100, "items": {
            "type": "object", "additionalProperties": false, "required": ["from", "to"],
            "properties": {
              "from": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,39}\\.[a-zA-Z][a-zA-Z0-9]{0,39}$" },
              "to": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,39}\\.[a-zA-Z][a-zA-Z0-9]{0,39}$" }
            }
          } }
        }
      }
    },
    "changelog": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
  }
}
